# ── Project-specific ─────────────────────────────────────────

# Large output directories (training results, holdout predictions, training logs)
results_training/
results_holdout/
logs/**
# Analysis results (PDFs, TSVs generated by run_full_analysis.py)
analysis/results/
# Analysis fitting outputs (generated PDFs)
analysis/fitting/*.pdf
# XGBoost trained models, tuning results, and Optuna DBs
analysis/XGBoost/trained_models/
analysis/XGBoost/tuning_results/
analysis/XGBoost/*.db
analysis/XGBoost/*.db-journal
# Legacy analysis outputs
analysis/legacy-code/GSEA/
analysis/legacy-code/GeneScores/

# Fold index JSON files + split TSVs generated per-dataset
data/*/

# Optuna SQLite databases
*.db
*.db-journal

# SLURM node blacklist (runtime artifact)
runs/bad_nodes.txt

# ── Python bytecode ──────────────────────────────────────────

__pycache__/
*.py[cod]
*$py.class

# ── C extensions ─────────────────────────────────────────────

*.so

