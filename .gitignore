# ── Project-specific ─────────────────────────────────────────

# Machine-specific path config
config/paths.yaml

# Large output directories (training results, holdout predictions, training logs)
results_training/
results_holdout/
logs/**

# Fold index JSON files + split TSVs generated per-dataset
data/*/

# Optuna SQLite databases
*.db
*.db-journal

# SLURM node blacklist (runtime artifact)
runs/bad_nodes.txt

# Micromamba environment dump (machine-specific snapshot)
proteus.env

