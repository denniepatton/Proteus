# ── Project-specific ─────────────────────────────────────────

# Large output directories (training results, holdout predictions, training logs)
# Keep the head folders present in the release but exclude all generated contents.
results_training/*
!results_training/.gitkeep
results_holdout/*
!results_holdout/.gitkeep
logs/**
# Analysis results (PDFs, TSVs generated by run_full_analysis.py)
analysis/results/
# Analysis fitting outputs (generated PDFs)
analysis/fitting/*.pdf
# XGBoost trained models, tuning results, and Optuna DBs
analysis/XGBoost/trained_models/
analysis/XGBoost/tuning_results/
analysis/XGBoost/*.db
analysis/XGBoost/*.db-journal
# Legacy analysis outputs
analysis/legacy-code/GSEA/
analysis/legacy-code/GeneScores/

# Shipped model directories: keep weights + config, exclude generated plots/interpretation
trained_models/**/plots/
trained_models/**/interpretation/

# Local machine-specific path overrides (ship paths.yaml.example instead)
config/paths.yaml

# Excel lock files
data/~$*.xlsx

# Cohort summaries workbook (not part of the public release)
data/CohortSummaries.xlsx

# Manuscript / working documents (not part of the public release)
*.docx

# Fold index JSON files + split TSVs generated per-dataset
data/*/

# Optuna SQLite databases
*.db
*.db-journal

# SLURM node blacklist (runtime artifact)
runs/bad_nodes.txt

# ── Python bytecode ──────────────────────────────────────────

__pycache__/
*.py[cod]
*$py.class

# ── C extensions ─────────────────────────────────────────────

*.so

# ── Distribution / packaging ────────────────────────────────

build/
dist/
*.egg-info/
*.egg

# ── Test / coverage ─────────────────────────────────────────

htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/

# ── Environments ─────────────────────────────────────────────

.env
.venv
env/
venv/

# ── Snakemake ────────────────────────────────────────────────

.snakemake/

# ── Editor / OS artifacts ───────────────────────────────────

core
.DS_Store
*.swp
*.swo
*~
.vscode/
*.code-workspace

# ── Jupyter ──────────────────────────────────────────────────

.ipynb_checkpoints

# ── Type checkers ────────────────────────────────────────────

.mypy_cache/
.pyre/

# ── Logs ─────────────────────────────────────────────────────

*.log
