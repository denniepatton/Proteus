name: proteus
channels:
  - pytorch
  - nvidia
  - conda-forge
  - bioconda
dependencies:
  - python=3.10
  - pip
  - pytorch=2.5.1
  - torchvision=0.20.1
  - torchaudio=2.5.1
  - pytorch-cuda=12.1
  - numpy>=2.0
  - pandas>=2.0
  - h5py>=3.10
  - scipy>=1.11
  - scikit-learn>=1.3
  - matplotlib>=3.8
  - seaborn>=0.13
  - zarr>=2.18
  - numcodecs>=0.12
  - optuna>=3.6
  - pyyaml>=6.0
  - rich>=13.0
  - lifelines>=0.28
  - gseapy>=1.1
  - rpy2>=3.5
  - r-base
  - bioconductor-limma
  - bioconductor-genefu
  - pip:
      - captum>=0.7
      - logomaker>=0.8
      - shap>=0.46
      - umap-learn>=0.5
